<%= form_with url: bulk_users_path, method: :patch, data: { controller: "selection" } do %>
  <div class="btn-toolbar gap-2 mb-2" role="toolbar" aria-label="User actions">
    <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Block selected users">
      <button type="submit" name="op" value="block" class="btn btn-outline-primary" data-selection-target="action" disabled>
        <i class="bi bi-lock-fill"></i> Block
      </button>
    </span>
    <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Unblock selected users">
      <button type="submit" name="op" value="unblock" class="btn btn-outline-primary" data-selection-target="action" aria-label="Unblock" disabled>
        <i class="bi bi-unlock-fill"></i>
      </button>
    </span>
    <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Delete selected users">
      <button type="submit" name="op" value="delete" class="btn btn-outline-danger" data-selection-target="action" aria-label="Delete" disabled>
        <i class="bi bi-trash"></i>
      </button>
    </span>
    <span class="ms-auto align-self-center small text-secondary">
      <span data-selection-target="count">0</span> selected ·
      <%= pluralize(@users.size, "user") %>
      (<%= @users.count(&:active?) %> active, <%= @users.count(&:blocked?) %> blocked)
    </span>
  </div>

  <div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" style="width: 2.5rem">
            <input type="checkbox" class="form-check-input" aria-label="Select all"
                   data-selection-target="all" data-action="selection#toggleAll">
          </th>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col">Status</th>
          <th scope="col">Last seen <i class="bi bi-arrow-down small"></i></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="<%= "text-secondary" if user.blocked? %>">
            <td>
              <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="form-check-input"
                     aria-label="Select <%= user.name %>" data-selection-target="row" data-action="selection#update">
            </td>
            <td>
              <div class="<%= "text-decoration-line-through" if user.blocked? %>">
                <%= user.name %><%= " (you)" if user == current_user %>
              </div>
              <div class="small text-secondary"><%= user.job_position.presence || "N/A" %></div>
            </td>
            <td><%= user.email %></td>
            <td><%= user.status.capitalize %></td>
            <td>
              <% if user.current_sign_in_at %>
                <span data-bs-toggle="tooltip" data-bs-title="<%= l(user.current_sign_in_at, format: :long) %>">
                  <%= time_ago_in_words(user.current_sign_in_at) %> ago
                </span>
              <% else %>
                never
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>